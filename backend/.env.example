# Server
PORT=5000
NODE_ENV=development
# Comma-separated if you have multiple frontends
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
# Cookie SameSite: lax (same-origin) | none (split frontend/API on different domains)
COOKIE_SAMESITE=lax

# Groq — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenWeather — https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Geoapify — https://www.geoapify.com
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# Sky Scrapper — https://rapidapi.com/apiheya/api/sky-scrapper
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=sky-scrapper.p.rapidapi.com

# Optional
CACHE_TTL_SECONDS=3600

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
MONGODB_DB_NAME=bonvoyage

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
